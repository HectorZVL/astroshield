{
  "name": "astroshield",
  "version": "1.0.0",
  "private": true,
  "description": "AstroShield — algoritmo evolutivo para diseñar una constelación de 8 satélites con restricciones espaciales y visualización 3D.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "experimentos": "tsx experiments/run-all.ts",
    "evolucionar": "tsx experiments/cli.ts",
    "verificar": "npm run typecheck && npm test && npm run experimentos"
  },
  "dependencies": {
    "three": "^0.169.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.169.0",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
